{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dwpm-cloud-shared-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "dwpm-data.292828.xyz",
      "custom_domain": true
    }
  ],
  // `cleanup` is garbage collection, and every statement left in it costs a
  // scan of the table it prunes - so its price is set by how much is stored,
  // while its value is set by how much has expired, which accrues slowly.  At
  // five-minute cadence that was ~1.3M row reads a day to keep a 0.16 MB
  // database tidy, a quarter of the account's whole D1 read allowance.
  // Nothing needs the shorter period: presence, scan leases, target leases and
  // TTLs are all re-derived from the clock by the readers that care
  // (`sharedMode`, `claimScans`, `queryTargets`, `reserveTarget`), so pruning
  // only reclaims space.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    "SHARED_ACCOUNT_THRESHOLD": "2",
    "PRESENCE_TTL_MILLIS": "90000",
    "SCAN_FRESH_MILLIS": "120000",
    "SCAN_LEASE_MILLIS": "45000",
    "TARGET_LEASE_MILLIS": "600000",
    "REJECT_RETRY_MILLIS": "120000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dwpm-cloud-shared-data",
      "database_id": "79d65a8e-4559-4745-a9fd-d5c017cd6dd2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}

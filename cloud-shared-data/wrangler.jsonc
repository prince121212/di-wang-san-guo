{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dwpm-cloud-shared-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "urllib": "./src/alipay-http.ts", "node:util": "./src/payment-node-util.ts" },
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "RUNTIME_CONFIG", "class_name": "RuntimeConfigStore" }]
  },
  "migrations": [{ "tag": "runtime-config-v1", "new_sqlite_classes": ["RuntimeConfigStore"] }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "dwpm-data.292828.xyz",
      "custom_domain": true
    }
  ],
  // `cleanup` is garbage collection, and every statement left in it costs a
  // scan of the table it prunes - so its price is set by how much is stored,
  // while its value is set by how much has expired, which accrues slowly.  At
  // five-minute cadence that was ~1.3M row reads a day to keep a 0.16 MB
  // database tidy, a quarter of the account's whole D1 read allowance.
  // Nothing needs the shorter period: presence, scan leases, target leases and
  // TTLs are all re-derived from the clock by the readers that care
  // (`sharedMode`, `claimScans`, `queryTargets`, `reserveTarget`), so pruning
  // only reclaims space.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    // Prepared production application; closed until credentials and acceptance are complete.
    "ALIPAY_MODE": "production",
    "ALIPAY_APP_ID": "2021007102687318",
    "ALIPAY_ORIGIN": "https://dwpm-data.292828.xyz",
    "ALIPAY_ENABLED": "false",
    "ALIPAY_APP_PAY_ENABLED": "false",
    "ALIPAY_LIVE_APPROVED": "false",
    // Owner-approved prices; this does NOT enable payments or production approval.
    "ALIPAY_PLAN_PRICES": "{\"month\":\"9.90\",\"quarter\":\"25.90\",\"year\":\"49.90\"}",
    "SHARED_ACCOUNT_THRESHOLD": "2",
    "PRESENCE_TTL_MILLIS": "300000",
    "SCAN_FRESH_MILLIS": "120000",
    "SCAN_LEASE_MILLIS": "45000",
    "TARGET_LEASE_MILLIS": "600000",
    "REJECT_RETRY_MILLIS": "120000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dwpm-cloud-shared-data",
      "database_id": "79d65a8e-4559-4745-a9fd-d5c017cd6dd2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}

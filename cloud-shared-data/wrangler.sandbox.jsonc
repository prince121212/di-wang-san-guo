{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dwpm-payment-sandbox-local",
  "main": "src/sandbox-entry.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {"urllib":"./src/alipay-http.ts", "node:util":"./src/payment-node-util.ts"},
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {"bindings":[{"name":"RUNTIME_CONFIG","class_name":"RuntimeConfigStore"}]},
  "migrations":[{"tag":"sandbox-v1","new_sqlite_classes":["RuntimeConfigStore"]}]
}
